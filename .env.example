# Titan Mail SMTP Configuration for contact@aegiswing.com
TITAN_SMTP_HOST=smtp.titan.email
TITAN_SMTP_PORT=465
TITAN_SMTP_USER=contact@aegiswing.com
TITAN_SMTP_PASSWORD=your_titan_email_password_here

# Notification Recipient (Default: contact@aegiswing.com)
NOTIFY_EMAIL=contact@aegiswing.com

# Public Site URL (for links inside notification emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ops Admin Passcode (Default: aegis-intel-2026)
ADMIN_PASSCODE=aegis-intel-2026
